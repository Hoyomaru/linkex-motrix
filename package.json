{
  "name": "linkex-motrix",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Linkexの共有ファイルを自分のストレージ経由でMotrixに渡すEdge拡張機能",
  "license": "MIT",
  "repository": {
    "type": "git",
